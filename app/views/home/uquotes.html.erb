<h3>Your Quotes</h3>
<hr />
<% @quotes.each do |quote| %>
 <div class="card bg-body-tertiary" style="margin-bottom:10px">
 <div class="card-body">
 <h4 class="card-title"><%= quote.text %></h4>
 <p class="card-text"><%= quote.categories.map(&:name).join(", ") %>
 <br />[<%= link_to "Read full quote", quote_path(quote) %>]</p>
 </div>
 </div>
<% end %>
