<h1>Welcome to My Quotes</h1>
<p>Where you can collect and share all your favourite quotes!</p>
<h3>Recently Added Quotes</h3>
<hr />


<% @quotes.each do |quote| %>
 <div class="card bg-body-tertiary" style="margin-bottom:10px">
 <div class="card-body">
 <h4 class="card-title"><%= quote.user.fname %></h4>
 <p class="card-text"><%= quote.text %><br />
 [<a href="/quotes/<%=quote.id %>">
    Read full quote
    </a>]</p>
 </div>
 </div>
 <% end %>
