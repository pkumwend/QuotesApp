<div id="<%= dom_id quote %>">
  <p>
    <strong>Text:</strong>
    <%= quote.text %>
  </p>

  <p>
    <strong>Pub year:</strong>
    <%= quote.pub_year %>
  </p>
  <p>
    <strong>Category:</strong>
    <%= quote.categories.map(&:name).join(", ") %>
  </p>
  <p>
    <strong>Comment:</strong>
    <%= quote.comment %>
  </p>

  <p>
    <strong>User:</strong>
    <%= quote.user.fname %>
  </p>

  <p>
    <strong>Source:</strong>
    <%= quote.source.fname + " " + quote.source.lname%>
  </p>

</div>
